# Loaded by `react-scripts start` only — never by `npm run build`.
#
# Emulator targeting used to be keyed on NODE_ENV === 'development' inside
# src/utils/firebase.js, which meant the dev server could never be pointed at a
# real project, and that Jest (NODE_ENV=test) silently fell through to
# production. It is now an explicit flag; see src/utils/firebaseEnv.js.
REACT_APP_USE_EMULATORS=true
